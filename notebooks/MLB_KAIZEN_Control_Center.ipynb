   "source": [
    "#@title Control Center\n",
    "from datetime import UTC, date, datetime\n",
    "from html import escape\n",
    "from zoneinfo import ZoneInfo\n",
    "\n",
    "import ipywidgets as widgets\n",
    "import matplotlib.pyplot as plt\n",
    "from IPython.display import HTML, display\n",
    "\n",
    "from mlb_kaizen.data.http import CachedHttpClient, DataProviderError\n",
    "from mlb_kaizen.data.mlb_stats import MLBStatsProvider\n",
    "from mlb_kaizen.interface.cli import run_daily_e11_inference\n",
    "from mlb_kaizen.market.odds import american_to_decimal, latest_complete_no_vig_snapshot\n",
    "\n",
    "MEXICO_CITY = ZoneInfo('America/Mexico_City')\n",
    "games_by_id = {}\n",
    "\n",
    "def mexico_now_text():\n",
    "    return datetime.now(MEXICO_CITY).isoformat(timespec='minutes')\n",
    "\n",
    "def provider():\n",
    "    settings = Settings.from_environment()\n",
    "    return MLBStatsProvider(CachedHttpClient(\n",
    "        settings.cache_dir, timeout_seconds=settings.http_timeout_seconds,\n",
    "        retries=settings.http_retries, cache_ttl_seconds=settings.cache_ttl_seconds,\n",
    "    ))\n",
    "\n",
    "def selected_game():\n",
    "    return games_by_id.get(game_picker.value)\n",
    "\n",
    "def selected_game_label():\n",
    "    game = selected_game()\n",
    "    if game is None:\n",
    "        return 'Primero actualiza el calendario y elige un juego.'\n",
    "    local_start = game.start_time.astimezone(MEXICO_CITY).strftime('%d/%m/%Y %I:%M %p') if game.start_time else 'hora no disponible'\n",
    "    kind = 'Temporada regular' if game.game_type == 'R' else f'No regular ({game.game_type or \"sin tipo\"})'\n",
    "    return f'<b>{escape(game.away_team_name)} @ {escape(game.home_team_name)}</b> — {local_start} CDMX — {kind}'\n",
    "\n",
    "def set_message(output, message, level='info'):\n",
    "    color = {'info': '#1f4e79', 'success': '#166534', 'warning': '#92400e', 'error': '#b91c1c'}[level]\n",
    "    output.value = f'<span style=\"color:{color}\">{escape(message)}</span>'\n",
    "\n",
    "schedule_date = widgets.DatePicker(description='Fecha:', value=date.today())\n",
    "refresh_schedule = widgets.Button(description='Actualizar calendario', button_style='primary', icon='refresh')\n",
    "game_picker = widgets.Dropdown(description='Juego:', options=[], layout=widgets.Layout(width='650px'))\n",
    "schedule_status = widgets.HTML()\n",
    "game_details = widgets.HTML()\n",
    "\n",
    "def refresh_schedule_clicked(_):\n",
    "    if schedule_date.value is None:\n",
    "        set_message(schedule_status, 'Elige una fecha.', 'error')\n",
    "        return\n",
    "    try:\n",
    "        games = provider().games_on(schedule_date.value)\n",
    "        database.initialise()\n",
    "        for game in games:\n",
    "            database.store_game_snapshot(game)\n",
    "        games_by_id.clear()\n",
    "        games_by_id.update({game.game_id: game for game in games})\n",
    "        game_picker.options = [\n",
    "            (f'{game.away_team_name} @ {game.home_team_name} — {game.game_id}', game.game_id)\n",
    "            for game in games\n",
    "        ]\n",
    "        set_message(schedule_status, f'{len(games)} juego(s) encontrados y guardados.', 'success')\n",
    "        game_details.value = selected_game_label()\n",
    "    except DataProviderError as exc:\n",
    "        set_message(schedule_status, f'No se pudo verificar el calendario: {exc}', 'error')\n",
    "\n",
    "def game_changed(_):\n",
    "    game_details.value = selected_game_label()\n",
    "    refresh_quote_history()\n",
    "\n",
    "refresh_schedule.on_click(refresh_schedule_clicked)\n",
    "game_picker.observe(game_changed, names='value')\n",
    "\n",
    "sportsbook = widgets.Text(description='Casa:', value='Playdoit')\n",
    "market = widgets.Dropdown(description='Mercado:', options=[('Moneyline', 'moneyline'), ('Total', 'total'), ('Run line', 'run_line')])\n",
    "selection = widgets.Dropdown(description='Selección:')\n",
    "line = widgets.FloatText(description='Línea:', value=0.0)\n",
    "american_odds = widgets.FloatText(description='Momio:', value=0.0)\n",
    "observed_at = widgets.Text(description='Hora vista:', value=mexico_now_text(), layout=widgets.Layout(width='500px'))\n",
    "save_quote = widgets.Button(description='Guardar cuota', button_style='success', icon='save')\n",
    "quote_status = widgets.HTML()\n",
    "\n",
    "def update_quote_form(_=None):\n",
    "    if market.value == 'total':\n",
    "        selection.options = [('Over', 'over'), ('Under', 'under')]\n",
    "        line.disabled = False\n",
    "    else:\n",
    "        selection.options = [('Visitante', 'away'), ('Local', 'home')]\n",
    "        line.disabled = market.value == 'moneyline'\n",
    "        if line.disabled:\n",
    "            line.value = 0.0\n",
    "\n",
    "def save_quote_clicked(_):\n",
    "    game = selected_game()\n",
    "    if game is None:\n",
    "        set_message(quote_status, 'Primero elige un juego.', 'error')\n",
    "        return\n",
    "    try:\n",
    "        seen_at = datetime.fromisoformat(observed_at.value.replace('Z', '+00:00'))\n",
    "        if seen_at.tzinfo is None or seen_at.utcoffset() is None:\n",
    "            raise ValueError('la hora debe incluir zona horaria, por ejemplo -06:00')\n",
    "        if not sportsbook.value.strip():\n",
    "            raise ValueError('escribe el nombre de la casa')\n",
    "        quote_id = database.store_market_quote(\n",
    "            game_id=game.game_id, sportsbook=sportsbook.value.strip(), market=market.value,\n",
    "            selection=selection.value, line=None if market.value == 'moneyline' else line.value,\n",
    "            decimal_odds=american_to_decimal(american_odds.value), captured_at=seen_at,\n",
    "            source='colab_manual',\n",
    "            payload={'entry_method': 'colab_manual', 'american_odds': american_odds.value, 'observed_at': seen_at.isoformat()},\n",
    "        )\n",
    "        set_message(quote_status, f'Cuota guardada: {quote_id}', 'success')\n",
    "        refresh_quote_history()\n",
    "    except ValueError as exc:\n",
    "        set_message(quote_status, f'No se guardó: {exc}', 'error')\n",
    "\n",
    "market.observe(update_quote_form, names='value')\n",
    "save_quote.on_click(save_quote_clicked)\n",
    "update_quote_form()\n",
    "\n",
    "quote_history = widgets.HTML()\n",
    "quote_plot = widgets.Output()\n",
    "\n",
    "def refresh_quote_history():\n",
    "    game = selected_game()\n",
    "    if game is None:\n",
    "        quote_history.value = ''\n",
    "        return\n",
    "    quotes = database.market_quotes_for_game(game.game_id)\n",
    "    if not quotes:\n",
    "        quote_history.value = '<i>Aún no hay cuotas guardadas para este juego.</i>'\n",
    "        with quote_plot:\n",
    "            quote_plot.clear_output(wait=True)\n",
    "        return\n",
    "    rows = ''.join(\n",
    "        f'<tr><td>{escape(q[\"captured_at\"])}</td><td>{escape(q[\"sportsbook\"])}</td><td>{escape(q[\"market\"])}</td><td>{escape(q[\"selection\"])}</td><td>{q[\"line\"] if q[\"line\"] is not None else \"—\"}</td><td>{q[\"payload\"].get(\"american_odds\", \"—\")}</td></tr>'\n",
    "        for q in quotes\n",
    "    )\n",
    "    quote_history.value = '<table style=\"border-collapse:collapse\"><tr><th>Hora vista</th><th>Casa</th><th>Mercado</th><th>Selección</th><th>Línea</th><th>Momio</th></tr>' + rows + '</table>'\n",
    "    with quote_plot:\n",
    "        quote_plot.clear_output(wait=True)\n",
    "        figure, axis = plt.subplots(figsize=(8, 3))\n",
    "        for label in sorted({f'{q[\"market\"]}: {q[\"selection\"]}' for q in quotes}):\n",
    "            series = [q for q in quotes if f'{q[\"market\"]}: {q[\"selection\"]}' == label]\n",
    "            axis.plot([q['captured_at'] for q in series], [q['decimal_odds'] for q in series], marker='o', label=label)\n",
    "        axis.set_title('Historial de cuotas decimales capturadas')\n",
    "        axis.set_ylabel('Cuota decimal')\n",
    "        axis.tick_params(axis='x', rotation=25)\n",
    "        axis.legend(loc='best')\n",
    "        figure.tight_layout()\n",
    "        plt.show()\n",
    "\n",
    "playoff_market = widgets.Dropdown(description='Mercado:', options=[('Moneyline', 'moneyline'), ('Total', 'total'), ('Run line', 'run_line')])\n",
    "show_market_probability = widgets.Button(description='Ver referencia de mercado', button_style='primary', icon='bar-chart')\n",
    "playoff_status = widgets.HTML()\n",
    "playoff_plot = widgets.Output()\n",
    "\n",
    "def show_market_probability_clicked(_):\n",
    "    game = selected_game()\n",
    "    if game is None:\n",
    "        set_message(playoff_status, 'Primero elige un juego.', 'error')\n",
    "        return\n",
    "    snapshot = latest_complete_no_vig_snapshot(database.market_quotes_for_game(game.game_id), market=playoff_market.value)\n",
    "    if snapshot is None:\n",
    "        set_message(playoff_status, 'Falta una pareja completa de cuotas de la misma casa, mercado, línea y hora vista. Guarda ambos lados usando exactamente la misma hora.', 'warning')\n",
    "        with playoff_plot:\n",
    "            playoff_plot.clear_output(wait=True)\n",
    "        return\n",
    "    local_time = snapshot.observed_at.astimezone(MEXICO_CITY).strftime('%d/%m/%Y %I:%M %p')\n",
    "    line_text = '' if snapshot.line is None else f' línea {snapshot.line:g}'\n",
    "    set_message(playoff_status, f'Referencia de mercado sin margen de {snapshot.sportsbook}, vista {local_time} CDMX{line_text}. No es una predicción del modelo.', 'info')\n",
    "    with playoff_plot:\n",
    "        playoff_plot.clear_output(wait=True)\n",
    "        labels = list(snapshot.probabilities)\n",
    "        values = [100 * snapshot.probabilities[label] for label in labels]\n",
    "        figure, axis = plt.subplots(figsize=(7, 2.8))\n",
    "        bars = axis.bar(labels, values, color=['#1f77b4', '#ff7f0e'])\n",
    "        axis.set_ylim(0, 100)\n",
    "        axis.set_ylabel('Probabilidad de mercado (%)')\n",
    "        axis.set_title('Referencia sin margen — no modelo ni recomendación')\n",
    "        for bar, value in zip(bars, values):\n",
    "            axis.text(bar.get_x() + bar.get_width() / 2, value + 2, f'{value:.1f}%', ha='center')\n",
    "        figure.tight_layout()\n",
    "        plt.show()\n",
    "\n",
    "show_market_probability.on_click(show_market_probability_clicked)\n",
    "\n",
    "home_score = widgets.BoundedIntText(description='Carreras local:', min=0, value=0)\n",
    "away_score = widgets.BoundedIntText(description='Carreras visitante:', min=0, value=0)\n",
    "record_result = widgets.Button(description='Guardar resultado final', button_style='warning', icon='flag-checkered')\n",
    "result_status = widgets.HTML()\n",
    "\n",
    "def record_result_clicked(_):\n",
    "    game = selected_game()\n",
    "    if game is None:\n",
    "        set_message(result_status, 'Primero elige un juego.', 'error')\n",
    "        return\n",
    "    result_id = database.store_result_snapshot(\n",
    "        game_id=game.game_id, recorded_at=datetime.now(UTC), source='colab_manual_official_final',\n",
    "        home_score=home_score.value, away_score=away_score.value,\n",
    "    )\n",
    "    set_message(result_status, f'Resultado guardado: {result_id}. Úsalo sólo cuando el marcador sea final oficial.', 'success')\n",
    "\n",
    "record_result.on_click(record_result_clicked)\n",
    "\n",
    "artifact_path = widgets.Text(description='Artefacto E11:', value=str(ARTIFACT_DIR / 'e3-e7-e8-e11'), layout=widgets.Layout(width='700px'))\n",
    "history_start = widgets.DatePicker(description='Historia desde:', value=date(2022, 3, 1))\n",
    "predict = widgets.Button(description='Predicción E11 (regular)', button_style='info', icon='calculator')\n",
    "prediction_status = widgets.HTML()\n",
    "\n",
    "def predict_clicked(_):\n",
    "    game = selected_game()\n",
    "    if game is None:\n",
    "        set_message(prediction_status, 'Primero elige un juego.', 'error')\n",
    "        return\n",
    "    if game.game_type != 'R':\n",
    "        set_message(prediction_status, 'Bloqueado: E11 sólo es para temporada regular; no genera predicciones de playoffs.', 'warning')\n",
    "        return\n",
    "    if not Path(artifact_path.value).exists():\n",
    "        set_message(prediction_status, 'Falta el artefacto E11 en Drive. No se entrenará ni se sustituirá automáticamente.', 'warning')\n",
    "        return\n",
    "    try:\n",
    "        result = run_daily_e11_inference(\n",
    "            provider=provider(), database=database, game_date=schedule_date.value, game_id=game.game_id,\n",
    "            history_start=history_start.value, artifact_path=Path(artifact_path.value),\n",
    "        )\n",
    "        probability = 100 * result['calibrated_home_win_probability']\n",
    "        set_message(prediction_status, f\"Predicción experimental guardada. Probabilidad local calibrada: {probability:.1f}%. No es recomendación de apuesta.\", 'success')\n",
    "    except (DataProviderError, OSError, RuntimeError, ValueError) as exc:\n",
    "        set_message(prediction_status, f'Predicción rechazada: {exc}', 'error')\n",
    "\n",
    "predict.on_click(predict_clicked)\n",
    "\n",
    "calendar_panel = widgets.VBox([widgets.HTML('<h3>Calendario</h3>'), widgets.HBox([schedule_date, refresh_schedule]), schedule_status, game_picker, game_details])\n",
    "quotes_panel = widgets.VBox([widgets.HTML('<h3>Cuotas que tú viste</h3>'), sportsbook, market, selection, line, american_odds, observed_at, save_quote, quote_status, widgets.HTML('<h4>Historial</h4>'), quote_history, quote_plot])\n",
    "playoff_panel = widgets.VBox([widgets.HTML('<h3>Playoffs: referencia de mercado</h3><p>Esta pestaña no ejecuta E11. Muestra únicamente lo que las cuotas completas de una casa implican después de quitar su margen proporcional.</p>'), playoff_market, show_market_probability, playoff_status, playoff_plot])\n",
    "result_panel = widgets.VBox([widgets.HTML('<h3>Resultado final</h3>'), home_score, away_score, record_result, result_status])\n",
    "model_panel = widgets.VBox([widgets.HTML('<h3>Modelo E11</h3><p>Experimental. Sólo temporada regular y antes del juego.</p>'), artifact_path, history_start, predict, prediction_status])\n",
    "tabs = widgets.Tab(children=[calendar_panel, quotes_panel, playoff_panel, result_panel, model_panel])\n",
    "for index, title in enumerate(['1. Calendario', '2. Cuotas', '3. Playoffs / mercado', '4. Resultado', '5. Modelo regular']):\n",
    "    tabs.set_title(index, title)\n",
    "display(tabs)"
   ]
  },
