        "#@title 1. Preparar MLB KAIZEN (ejecutar una vez por sesión)\n",
        "from google.colab import drive\n",
        "from pathlib import Path\n",
        "import os\n",
        "import subprocess\n",
        "import sys\n",
        "\n",
        "drive.mount('/content/drive')\n",
        "\n",
        "REPOSITORY_URL = 'https://github.com/valentino1garcia2-glitch/mlb-kaizen.git'\n",
        "REPOSITORY_DIR = Path('/content/mlb-kaizen')\n",
        "DRIVE_ROOT = Path('/content/drive/MyDrive/MLB_KAIZEN')\n",
        "DATA_DIR = DRIVE_ROOT / 'data'\n",
        "ARTIFACT_DIR = DRIVE_ROOT / 'artifacts'\n",
        "\n",
        "if REPOSITORY_DIR.exists():\n",
        "    subprocess.run(['git', '-C', str(REPOSITORY_DIR), 'pull', '--ff-only'], check=True)\n",
        "else:\n",
        "    subprocess.run(['git', 'clone', REPOSITORY_URL, str(REPOSITORY_DIR)], check=True)\n",
        "\n",
        "subprocess.run([sys.executable, '-m', 'pip', 'install', '-q', '-e', '.[all]'], cwd=REPOSITORY_DIR, check=True)\n",
        "os.chdir(REPOSITORY_DIR)\n",
        "DATA_DIR.mkdir(parents=True, exist_ok=True)\n",
        "ARTIFACT_DIR.mkdir(parents=True, exist_ok=True)\n",
        "os.environ['MLB_KAIZEN_DATA_DIR'] = str(DATA_DIR)\n",
        "\n",
        "from mlb_kaizen.config.settings import Settings\n",
        "from mlb_kaizen.storage.database import KaizenDatabase\n",
        "database = KaizenDatabase(Settings.from_environment().database_path)\n",
        "database.initialise()\n",
        "print('Listo. Tus capturas se guardarán en:', Settings.from_environment().database_path)"
      ],
