    "\n",
    "subprocess.run([sys.executable, '-m', 'pip', 'install', '-q', '-e', '.[all]'], cwd=REPOSITORY_DIR, check=True)\n",
    "# Al actualizar el repositorio durante una sesión, evita que Python siga\n",
    "# usando módulos viejos que ya estaban cargados en memoria.\n",
    "importlib.invalidate_caches()\n",
    "for module_name in tuple(sys.modules):\n",
