    "database.initialise()\n",
    "version = subprocess.run(['git', '-C', str(REPOSITORY_DIR), 'rev-parse', '--short', 'HEAD'], check=True, capture_output=True, text=True).stdout.strip()\n",
    "print('Listo. Código:', version)\n",
